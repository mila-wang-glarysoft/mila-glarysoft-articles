---
import BlogChrome from './BlogChrome.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { articleCategories } from '../data/articleCategories.js';
import { categories, getPaginationPages } from '../data/posts.js';
import '../styles/home.css';

const { category, page } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pageTitle = page.currentPage > 1
  ? `${category.name} - Page ${page.currentPage} | Glarysoft Articles`
  : `${category.name} | Glarysoft Articles`;
const childCategories = category.slug === 'how-to' ? categories : [];
const emptyMessage = category.emptyMessage || 'New articles are coming soon.';
---

<MainLayout
  title={pageTitle}
  description={category.description}
>
  <main class="archive-page">
    <section class="blog-hero archive-hero">
      <div class="blog-container blog-hero-simple">
        <nav class="blog-breadcrumb archive-breadcrumb" aria-label="Breadcrumb">
          <a href="https://www.glarysoft.com/">Home</a>
          <span>/</span>
          <a href={`${basePath}articles/`}>Articles</a>
        </nav>
        <h1>{category.name}</h1>
        <p class="blog-lead">{category.description}</p>
      </div>
    </section>

    <section class="blog-section">
      <div class="blog-container">
        <nav class="article-category-tabs" aria-label="Article categories">
          {articleCategories.map((item) => (
            <a
              href={item.href}
              class:list={[{ active: item.slug === category.slug }]}
              aria-current={item.slug === category.slug ? 'page' : undefined}
            >
              {item.name}
            </a>
          ))}
        </nav>

        {page.items.length === 0 && (
          <p class="empty-state">
            {emptyMessage}
          </p>
        )}

        {childCategories.length > 0 && (
          <div class="child-category-panel">
            <div class="child-category-grid">
              {childCategories.map((child) => (
                <a href={child.href}>
                  <span>{child.name}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="post-list simple-list category-article-grid">
          {page.items.map((post) => (
            <article class="post-row">
              <div>
                <p class="post-category">{post.category}</p>
                <h3><a href={post.href}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
              </div>
            </article>
          ))}
        </div>

        {page.totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            {page.hasPreviousPage && (
              <a href={page.currentPage === 2 ? category.href : `${category.href}${page.currentPage - 1}/`}>
                Previous
              </a>
            )}
            {getPaginationPages(page.totalPages, page.currentPage).map((pageNumber) => (
              pageNumber === 'ellipsis' ? (
                <span class="pagination-ellipsis">...</span>
              ) : pageNumber === page.currentPage ? (
                <span class="current-page" aria-current="page">{pageNumber}</span>
              ) : (
                <a href={pageNumber === 1 ? category.href : `${category.href}${pageNumber}/`}>
                  {pageNumber}
                </a>
              )
            ))}
            {page.hasNextPage && (
              <a href={`${category.href}${page.currentPage + 1}/`}>Next</a>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>

  <BlogChrome />
</MainLayout>
