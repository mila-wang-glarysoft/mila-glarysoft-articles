---
import BlogChrome from '../../../components/BlogChrome.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import {
  categories,
  getCategoryBySlug,
  getCategoryChildren,
  getPaginationPages,
  getPostsByCategory,
  pageSize,
  paginate,
} from '../../../data/posts.js';
import '../../../styles/home.css';

export function getStaticPaths() {
  const parentCategoryPages = categories.filter((category) => !category.parentSlug).flatMap((category) => {
    const totalPages = Math.ceil(getPostsByCategory(category.slug).length / pageSize);

    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
      const pageNumber = index + 2;
      return {
        params: { slug: category.slug, page: String(pageNumber) },
        props: { category, pageNumber, parentCategory: null },
      };
    });
  });

  const childCategoryPages = categories
    .filter((category) => category.parentSlug)
    .map((category) => ({
      params: { slug: category.parentSlug, page: category.slug },
      props: {
        category,
        pageNumber: 1,
        parentCategory: getCategoryBySlug(category.parentSlug),
      },
    }));

  return [...parentCategoryPages, ...childCategoryPages];
}

const { category, pageNumber, parentCategory } = Astro.props;
const page = paginate(getPostsByCategory(category.slug), pageNumber);
const childCategories = getCategoryChildren(category.slug);
const pageTitle = page.currentPage > 1
  ? `${category.name} - Page ${page.currentPage} | Glarysoft Knowledge Base`
  : `${category.name} | Glarysoft Knowledge Base`;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MainLayout
  title={pageTitle}
  description={category.description}
>
  <main class="archive-page">
    <section class="blog-hero archive-hero">
      <div class="blog-container blog-hero-simple">
        <nav class="blog-breadcrumb archive-breadcrumb" aria-label="Breadcrumb">
          <a href="https://www.glarysoft.com/">Home</a>
          <span>/</span>
          <a href={basePath}>Knowledge Base</a>
          {parentCategory && (
            <>
              <span>/</span>
              <a href={parentCategory.href}>{parentCategory.name}</a>
            </>
          )}
        </nav>
        <h1>{category.name}</h1>
        <p class="blog-lead">{category.description}</p>
      </div>
    </section>

    <section class="blog-section">
      <div class="blog-container">
        {childCategories.length > 0 && (
          <div class="child-category-panel">
            <div class="child-category-grid">
              {childCategories.map((child) => (
                <a href={child.href}>
                  <span>{child.name}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="post-list simple-list category-article-grid">
          {page.items.map((post) => (
            <article class="post-row">
              <div>
                <p class="post-category">{post.category}</p>
                <h3><a href={post.href}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
              </div>
            </article>
          ))}
        </div>

        {page.totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            {page.hasPreviousPage && (
              <a href={page.currentPage === 2 ? category.href : `${category.href}${page.currentPage - 1}/`}>
                Previous
              </a>
            )}
            {getPaginationPages(page.totalPages).map((pageNumber) => (
              pageNumber === page.currentPage ? (
                <span class="current-page" aria-current="page">{pageNumber}</span>
              ) : (
                <a href={pageNumber === 1 ? category.href : `${category.href}${pageNumber}/`}>
                  {pageNumber}
                </a>
              )
            ))}
            {page.hasNextPage && (
              <a href={`${category.href}${page.currentPage + 1}/`}>Next</a>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>

  <BlogChrome />
</MainLayout>
