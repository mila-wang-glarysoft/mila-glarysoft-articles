---
import BlogChrome from '../../components/BlogChrome.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import {
  categories,
  getCategoryChildren,
  getCategoryBySlug,
  getPaginationPages,
  getRelatedPosts,
  getPostsByCategory,
  formatTagName,
  paginate,
  posts,
  slugifyTag,
  topCategories,
} from '../../data/posts.js';
import '../../styles/home.css';

export function getStaticPaths() {
  const postPaths = posts.map((post) => ({
    params: { slug: post.slug },
    props: { type: 'post', post },
  }));

  const categoryPaths = categories
    .filter((category) => !category.parentSlug && !posts.some((post) => post.slug === category.slug))
    .map((category) => ({
      params: { slug: category.slug },
      props: { type: 'category', category },
    }));

  return [...postPaths, ...categoryPaths];
}

const { type, post, category } = Astro.props;
const isPost = type === 'post';
const Content = isPost ? post.Content : null;
const relatedPosts = isPost ? getRelatedPosts(post.slug) : [];
const postCategory = isPost ? getCategoryBySlug(post.categorySlug) : null;
const postParentCategory = postCategory?.parentSlug ? getCategoryBySlug(postCategory.parentSlug) : null;
const categoryPosts = !isPost ? paginate(getPostsByCategory(category.slug)) : null;
const childCategories = !isPost ? getCategoryChildren(category.slug) : [];
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const hasHeadings = isPost && post.headings.length > 0;
const hasTags = isPost && post.tags.length > 0;
---

{isPost ? (
  <MainLayout
    title={`${post.title} | Glarysoft Knowledge Base`}
    description={post.excerpt}
  >
    <main class="post-page">
      <div class="blog-container post-layout">
        <article class="blog-post">
          <nav class="blog-breadcrumb" aria-label="Breadcrumb">
            <a href="https://www.glarysoft.com/">Home</a>
            <span>/</span>
            <a href={basePath}>Knowledge Base</a>
            <span>/</span>
            {postParentCategory && (
              <>
                <a href={postParentCategory.href}>{postParentCategory.name}</a>
                <span>/</span>
              </>
            )}
            <a href={post.categoryHref}>{post.category}</a>
          </nav>

          <header class="blog-post-header">
            <h1>{post.title}</h1>
          </header>

          {post.featured_image && (
            <img
              class="blog-hero-image"
              src={post.featured_image}
              alt={post.title}
            />
          )}

          <div class="blog-content">
            <Content />
          </div>
        </article>

        <aside class="post-aside">
          {hasHeadings && (
            <div class="toc">
              <h2>In This Article</h2>
              {post.headings.map((heading) => (
                <a href={`#${heading.id}`}>{heading.text}</a>
              ))}
            </div>
          )}

          <div class="post-categories">
            {topCategories.map((category) => (
              <div class="category-group">
                <a class="category-parent" href={category.href}>{category.name}</a>
                {getCategoryChildren(category.slug).length > 0 && (
                  <div class="category-children">
                    {getCategoryChildren(category.slug).map((child) => (
                      <a href={child.href}>{child.name}</a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          <div class="post-cta">
            <h2>Try Glary Utilities</h2>
            <p>Clean, optimize, and maintain your Windows PC with one utility.</p>
            <a href="https://www.glarysoft.com/downloads/?p=gu-page">
              Free Download
            </a>
          </div>

          {hasTags && (
            <div class="post-tags">
              <h2>Tags</h2>
              <div>
                {post.tags.map((tag) => (
                  <a href={`${basePath}tags/${slugifyTag(tag)}/`}>{formatTagName(tag)}</a>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>

      <section class="related-posts">
        <div class="blog-container">
          <h2>Related Articles</h2>
          <div class="related-grid">
            {relatedPosts.map((relatedPost) => (
              <a href={relatedPost.href} class="related-card">
                <span>{relatedPost.category}</span>
                <h3>{relatedPost.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <BlogChrome />
    <script is:inline>
      function slugifyHeading(value) {
        return value
          .toLowerCase()
          .replace(/&/g, "and")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      document.querySelectorAll(".blog-content p").forEach(function (paragraph) {
        var strong = paragraph.querySelector(":scope > strong:first-child");
        if (!strong) return;

        var text = strong.textContent.trim();
        if (!text || text.length > 90) return;

        var id = slugifyHeading(text);
        if (id && !document.getElementById(id)) {
          paragraph.id = id;
        }
      });
    </script>
  </MainLayout>
) : (
  <MainLayout
    title={`${category.name} | Glarysoft Knowledge Base`}
    description={category.description}
  >
    <main class="archive-page">
      <section class="blog-hero archive-hero">
        <div class="blog-container blog-hero-simple">
          <nav class="blog-breadcrumb archive-breadcrumb" aria-label="Breadcrumb">
            <a href="https://www.glarysoft.com/">Home</a>
            <span>/</span>
            <a href={basePath}>Knowledge Base</a>
          </nav>
          <h1>{category.name}</h1>
          <p class="blog-lead">{category.description}</p>
        </div>
      </section>

      <section class="blog-section">
        <div class="blog-container">
          {childCategories.length > 0 && (
            <div class="child-category-panel">
              <div class="child-category-grid">
                {childCategories.map((child) => (
                  <a href={child.href}>
                    <span>{child.name}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="post-list simple-list category-article-grid">
            {categoryPosts.items.map((post) => (
              <article class="post-row">
                <div>
                  <p class="post-category">{post.category}</p>
                  <h3><a href={post.href}>{post.title}</a></h3>
                  <p>{post.excerpt}</p>
                </div>
              </article>
            ))}
          </div>

          {categoryPosts.totalPages > 1 && (
            <nav class="pagination" aria-label="Pagination">
              {categoryPosts.hasPreviousPage && (
                <a href={categoryPosts.currentPage === 2 ? category.href : `${category.href}${categoryPosts.currentPage - 1}/`}>
                  Previous
                </a>
              )}
              {getPaginationPages(categoryPosts.totalPages).map((pageNumber) => (
                pageNumber === categoryPosts.currentPage ? (
                  <span class="current-page" aria-current="page">{pageNumber}</span>
                ) : (
                  <a href={pageNumber === 1 ? category.href : `${category.href}${pageNumber}/`}>
                    {pageNumber}
                  </a>
                )
              ))}
              {categoryPosts.hasNextPage && (
                <a href={`${category.href}${categoryPosts.currentPage + 1}/`}>
                  Next
                </a>
              )}
            </nav>
          )}
        </div>
      </section>
    </main>

    <BlogChrome />
  </MainLayout>
)}
