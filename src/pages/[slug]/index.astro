---
import BlogChrome from '../../components/BlogChrome.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { categories, getRelatedPosts, posts } from '../../data/posts.js';
import '../../styles/home.css';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.Content;
const relatedPosts = getRelatedPosts(post.slug);
---

<MainLayout
  title={`${post.title} | Glarysoft Blog`}
  description={post.excerpt}
>
  <main class="post-page">
    <div class="blog-container post-layout">
      <article class="blog-post">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="https://www.glarysoft.com/">Home</a>
          <span>/</span>
          <a href="/">Blog</a>
          <span>/</span>
          <a href={post.categoryHref}>{post.category}</a>
        </nav>

        <header class="blog-post-header">
          <h1>{post.title}</h1>
          <p class="blog-summary">{post.excerpt}</p>
          <div class="blog-meta">
            <span>Updated {post.dateLabel}</span>
          </div>
        </header>

        {post.featured_image && (
          <img
            class="blog-hero-image"
            src={post.featured_image}
            alt={post.title}
          />
        )}

        <div class="blog-content">
          <Content />
        </div>
      </article>

      <aside class="post-aside">
        <div class="toc">
          <h2>In This Post</h2>
          {post.headings.map((heading) => (
            <a href={`#${heading.id}`}>{heading.text}</a>
          ))}
        </div>

        <div class="post-categories">
          <h2>Categories</h2>
          {categories.map((category) => (
            <a href={category.href}>{category.name}</a>
          ))}
        </div>

        <div class="post-cta">
          <h2>Try Glary Utilities</h2>
          <p>Clean, optimize, and maintain your Windows PC with one utility.</p>
          <a href="https://www.glarysoft.com/downloads/?p=gu-page">
            Free Download
          </a>
        </div>
      </aside>
    </div>

    <section class="related-posts">
      <div class="blog-container">
        <h2>Related Posts</h2>
        <div class="related-grid">
          {relatedPosts.map((relatedPost) => (
            <a href={relatedPost.href} class="related-card">
              <span>{relatedPost.category}</span>
              <h3>{relatedPost.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <BlogChrome />
</MainLayout>
