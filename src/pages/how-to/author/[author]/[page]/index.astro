---
import BlogChrome from '../../../../../components/BlogChrome.astro';
import MainLayout from '../../../../../layouts/MainLayout.astro';
import {
  authors,
  getAuthorBySlug,
  getPaginationPages,
  getPostsByAuthor,
  pageSize,
  paginate,
} from '../../../../../data/posts.js';
import '../../../../../styles/home.css';

export function getStaticPaths() {
  return authors.flatMap((author) => {
    const totalPages = Math.ceil(getPostsByAuthor(author.slug).length / pageSize);

    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
      const pageNumber = index + 2;
      return {
        params: {
          author: author.slug,
          page: String(pageNumber),
        },
        props: { author, pageNumber },
      };
    });
  });
}

const { author, pageNumber } = Astro.props;
const authorInfo = getAuthorBySlug(author.slug);
const page = paginate(getPostsByAuthor(author.slug), pageNumber);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MainLayout
  title={`${authorInfo.name} - Page ${page.currentPage} | Glarysoft Articles`}
  description={`Articles by ${authorInfo.name} from Glarysoft.`}
>
  <main class="archive-page">
    <section class="blog-hero archive-hero">
      <div class="blog-container blog-hero-simple">
        <nav class="blog-breadcrumb archive-breadcrumb" aria-label="Breadcrumb">
          <a href="https://www.glarysoft.com/">Home</a>
          <span>/</span>
          <a href={`${basePath}articles/`}>Articles</a>
          <span>/</span>
          <a href={`${basePath}how-to/`}>How To</a>
        </nav>
        <h1>{authorInfo.name}</h1>
      </div>
    </section>

    <section class="blog-section">
      <div class="blog-container">
          <div class="post-list simple-list category-article-grid">
            {page.items.map((post) => (
              <article class="post-row">
                <div>
                  <p class="post-category">{post.category}</p>
                  <h3><a href={post.href}>{post.title}</a></h3>
                  <p>{post.excerpt}</p>
                </div>
              </article>
            ))}
          </div>

          {page.totalPages > 1 && (
            <nav class="pagination" aria-label="Pagination">
              {page.hasPreviousPage && (
                <a href={page.currentPage === 2 ? authorInfo.href : `${authorInfo.href}${page.currentPage - 1}/`}>
                  Previous
                </a>
              )}
              {getPaginationPages(page.totalPages, page.currentPage).map((pageNumber) => (
                pageNumber === 'ellipsis' ? (
                  <span class="pagination-ellipsis">...</span>
                ) : pageNumber === page.currentPage ? (
                  <span class="current-page" aria-current="page">{pageNumber}</span>
                ) : (
                  <a href={pageNumber === 1 ? authorInfo.href : `${authorInfo.href}${pageNumber}/`}>
                    {pageNumber}
                  </a>
                )
              ))}
              {page.hasNextPage && (
                <a href={`${authorInfo.href}${page.currentPage + 1}/`}>Next</a>
              )}
            </nav>
          )}
      </div>
    </section>
  </main>

  <BlogChrome />
</MainLayout>
