---
import BlogChrome from '../../../../components/BlogChrome.astro';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { getPaginationPages, getPostsByTag, pageSize, paginate, tags } from '../../../../data/posts.js';
import '../../../../styles/home.css';

export function getStaticPaths() {
  return tags.flatMap((tag) => {
    const totalPages = Math.ceil(getPostsByTag(tag.slug).length / pageSize);

    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
      const pageNumber = index + 2;
      return {
        params: { slug: tag.slug, page: String(pageNumber) },
        props: { tag, pageNumber },
      };
    });
  });
}

const { tag, pageNumber } = Astro.props;
const page = paginate(getPostsByTag(tag.slug), pageNumber);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MainLayout
  title={`${tag.name} - Page ${page.currentPage} | Glarysoft Articles`}
  description={`Articles tagged ${tag.name} from Glarysoft.`}
>
  <main class="archive-page">
    <section class="blog-hero archive-hero">
      <div class="blog-container blog-hero-simple">
        <nav class="blog-breadcrumb archive-breadcrumb" aria-label="Breadcrumb">
          <a href="https://www.glarysoft.com/">Home</a>
          <span>/</span>
          <a href={basePath}>Articles</a>
        </nav>
        <h1>{tag.name}</h1>
        <p class="blog-lead">Articles tagged {tag.name}.</p>
      </div>
    </section>

    <section class="blog-section">
      <div class="blog-container">
        <div class="post-list simple-list category-article-grid">
          {page.items.map((post) => (
            <article class="post-row">
              <div>
                <p class="post-category">{post.category}</p>
                <h3><a href={post.href}>{post.title}</a></h3>
                <p>{post.excerpt}</p>
              </div>
            </article>
          ))}
        </div>

        {page.totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            {page.hasPreviousPage && (
              <a href={page.currentPage === 2 ? tag.href : `${tag.href}${page.currentPage - 1}/`}>
                Previous
              </a>
            )}
            {getPaginationPages(page.totalPages, page.currentPage).map((pageNumber) => (
              pageNumber === 'ellipsis' ? (
                <span class="pagination-ellipsis">...</span>
              ) : pageNumber === page.currentPage ? (
                <span class="current-page" aria-current="page">{pageNumber}</span>
              ) : (
                <a href={pageNumber === 1 ? tag.href : `${tag.href}${pageNumber}/`}>
                  {pageNumber}
                </a>
              )
            ))}
            {page.hasNextPage && (
              <a href={`${tag.href}${page.currentPage + 1}/`}>Next</a>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>

  <BlogChrome />
</MainLayout>
